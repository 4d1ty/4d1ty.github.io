						width="200"
						loading="lazy"
					/>
				</a>
			</li>
			<li>
				<strong><code>Arduino Ultrasonic Sensor Radar</code></strong>:
				Yup it's a classic
				<br />
				<iframe
					width="200"
					height="125"
					src="https://www.youtube.com/embed/95IuUE28pEY?si=ZwUwdiNC4242dOqz"
					loading="lazy"
					title="Arduino Ultrasonic Sensor Radar Demo"
					frameborder="0"
					allowfullscreen></iframe>
